# Copy to .env for local overrides. docker-compose.yml already sets working values for development.

# Postgres connection. On Vercel, the Neon integration sets both of these for you:
# DATABASE_URL goes through Neon's connection pooler; DATABASE_URL_UNPOOLED is the direct
# connection, used only to apply migrations during the build.
DATABASE_URL=postgres://pocus:pocus@localhost:5432/pocus
# DATABASE_URL_UNPOOLED=

# Seconds to keep a database connection open between requests.
# Defaults to 0 on Vercel (a fresh connection per request) and 600 elsewhere.
# DJANGO_CONN_MAX_AGE=

# true for local development only.
DJANGO_DEBUG=true

# Required when DJANGO_DEBUG is false. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated host names the site is served from, e.g. pocusatriver.com,www.pocusatriver.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Full origins (with https://) for forms posted from your domain, e.g. https://pocusatriver.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Outgoing email (SMTP). Not used until email notifications are added.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=events@pocusatriver.com
