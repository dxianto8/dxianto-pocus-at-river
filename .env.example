# Copy to .env for local overrides. docker-compose.yml already sets working values for development.

# Postgres connection. On Vercel, the Neon integration sets both of these for you:
# DATABASE_URL goes through Neon's connection pooler; DATABASE_URL_UNPOOLED is the direct
# connection, used only to apply migrations during the build.
DATABASE_URL=postgres://pocus:pocus@localhost:5432/pocus
# DATABASE_URL_UNPOOLED=

# Seconds to keep a database connection open between requests.
# Defaults to 0 on Vercel (a fresh connection per request) and 600 elsewhere.
# DJANGO_CONN_MAX_AGE=

# true for local development only.
DJANGO_DEBUG=true

# Required when DJANGO_DEBUG is false. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated host names the site is served from, e.g. pocusatriver.com,www.pocusatriver.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Full origins (with https://) for forms posted from your domain, e.g. https://pocusatriver.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Outgoing email (SMTP). Required in production for password resets and event notifications.
# Status notifications and password resets use the same configured mail backend.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=events@pocusatriver.com

# First admin login, created during deploy if it doesn't exist yet (scripts/vercel_build.py).
# Delete DJANGO_SUPERUSER_PASSWORD once you've signed in.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_PASSWORD=
# DJANGO_SUPERUSER_EMAIL=

# SendGrid v3 email API, used for notifications AND password resets when set.
# Verify DEFAULT_FROM_EMAIL as a sender in SendGrid. SMTP remains a fallback without this key.
# SENDGRID_API_KEY=
# PUBLIC_SITE_URL=https://pocusatriver.com

# Optional Twilio texting. Customers must enable texting and enter an international number.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# In Twilio, set the number's incoming-message webhook to https://YOUR_DOMAIN/notifications/sms/
# so signed STOP messages also turn off the app's texting preference.

# Set a long random secret in Vercel. Vercel includes it in the daily cron request's bearer header.
# CRON_SECRET=
# Automation also needs its email/text switches enabled in Admin > Venue settings.

# Optional: reading uploaded catering menus with Claude (Admin > Menu uploads).
# Create a key at https://platform.claude.com and add it in Vercel's Environment Variables.
# Without it, menu files can still be uploaded and items added by hand.
# ANTHROPIC_API_KEY=
